					<ProtectedString name="Source"><![CDATA[local Kick = {}

local Vanta = require(script.Parent.Parent)
local Version = Vanta.Version or "?"

local Messages = {
	"I love executors",
	"executors are actually pretty cool",
	"the anti-cheat is feeling silly today",
	"I support your executor journey",
	"the script was too powerful",
	"that executor was kinda fire ngl",
	"the server is jealous of your executor",
	"anti-cheat caught me lacking",
	"I have no idea what I'm doing",
	"the code told me to kick you",
	"I was paid to do this",
	"the server demanded a sacrifice",
