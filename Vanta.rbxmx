				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")

local Vanta = script.Parent
local Settings = require(Vanta)
local Modules = Vanta:WaitForChild("Modules")
local Client = Vanta:WaitForChild("Client")

if Settings.AntiDeletion then
	local ClientScript = Client:FindFirstChild("VNT_AntiDeletion")

	if ClientScript then
		ClientScript.Parent = ReplicatedFirst
	end

	task.spawn(function()
		require(Modules:FindFirstChild("AntiDeletion"))
	end)
end

local NotifyScript = Client:FindFirstChild("VNT_Notify")

if NotifyScript then
	NotifyScript.Parent = ReplicatedFirst
end

task.spawn(function()
	if Settings.AntiBackdoor then
		require(Modules:FindFirstChild("AntiBackdoor"))
	end
end)

task.spawn(function()
	if Settings.AntiSpeed then
		require(Modules:FindFirstChild("AntiSpeed"))
	end
end)

task.spawn(function()
	if Settings.AntiTeleport then
		require(Modules:FindFirstChild("AntiTeleport"))
	end
end)

task.spawn(function()
	if Settings.AntiNoclip then
		require(Modules:FindFirstChild("AntiNoclip"))
	end
end)

task.spawn(function()
	if Settings.AntiFly then
		require(Modules:FindFirstChild("AntiFly"))
	end
end)

task.spawn(function()
	if Settings.AntiFling then
		require(Modules:FindFirstChild("AntiFling"))
	end
end)]]></ProtectedString>
