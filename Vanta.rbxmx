local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Version = "1.0.0"

local VERSION_URL = "https://raw.githubusercontent.com/JustSomeGuest/Vanta/Main/Version.txt"

local Settings = {

	-- Detects backdoor scanners using a honeypot RemoteEvent.
	AntiBackdoor = true,

	-- Prevents protected LocalScripts, ModuleScripts, RemoteEvents,
	-- and Vanta's notification UI from being deleted.
	AntiDeletion = true,

	-- Detects and corrects abnormal player movement speeds.
	AntiSpeed = {
		Enabled = true,

		AllowedSpeeds = {
			16,
		},
	},

	-- Detects abnormal position changes that exceed the configured
	-- teleport distance. Violations are tracked using strikes.
	AntiTeleport = {
		Enabled = true,

		StrikeLimit = 3,
		StrikeCooldown = 5,
	},

	-- Detects players moving through solid objects.
	AntiNoclip = {
		Enabled = true,

		StrikeLimit = 3,
		StrikeCooldown = 5,
	},

	-- Detects abnormal airborne movement that may indicate flying.
	AntiFly = {
		Enabled = true,

		MaxAirTime = 1.8,
		StrikeLimit = 3,
		StrikeCooldown = 5,
	},

	-- Prevents abnormal physics from flinging players.
	AntiFling = true,
}

-- Modules that support .Whitelist(Player, Duration)
local WhitelistModules = {
	"AntiFly",
	"AntiNoclip",
	"AntiSpeed",
	"AntiTeleport",
}

local Api = {}

Api.Version = Version

local function ParseVersion(Text)
	local Major, Minor, Patch = string.match(
		Text,
		"^%s*v?(%d+)%.(%d+)%.(%d+)%s*$"
	)

	if not Major then
		return nil
	end

	return {
		tonumber(Major),
		tonumber(Minor),
		tonumber(Patch),
	}
end

local function IsOutdated(Current, Latest)
	for Index = 1, 3 do
		if Latest[Index] > Current[Index] then
			return true
		end

		if Latest[Index] < Current[Index] then
			return false
		end
	end

	return false
end

local function CheckForUpdates()
	local Success, Body = pcall(function()
		return HttpService:GetAsync(VERSION_URL, true)
	end)

	if not Success then
		return
	end

	local Current = ParseVersion(Version)
	local Latest = ParseVersion(Body)

	if not Current or not Latest then
		return
	end

	if IsOutdated(Current, Latest) then
		local NewestVersion =
			Latest[1] .. "."
			.. Latest[2] .. "."
			.. Latest[3]

		warn(
			"[Vanta Anticheat | v" .. Version .. "]"
				.. "\nThis version of Vanta is outdated! Get the newest version from the main module."
				.. "\nCurrent version: v" .. Version
				.. "\nNewest version: v" .. NewestVersion
		)
	end
end

if RunService:IsServer() then
	task.spawn(CheckForUpdates)
end

--[[
	Vanta.Whitelist(Player, Duration, Only)

	Temporarily prevents Vanta's movement checks from flagging a player.
	This is useful for legitimate game mechanics that move players in ways
	Vanta would normally detect, such as portals, teleport pads, launchers,
	and cutscenes.

	Player:   the player to whitelist
	Duration: how long in seconds (default 1)
	Only:     optional, a module name or a list of module names
	          leave it out to whitelist the player in every supported module

	Supported modules: AntiFly, AntiNoclip, AntiSpeed, AntiTeleport

	Usage (server scripts only):

	local Vanta = require(script.Parent.Vanta)

	-- whitelist everything for 2 seconds, then teleport
	Vanta.Whitelist(Player, 2)
	Character:PivotTo(PortalExit.CFrame)

	-- only whitelist the checks a portal would trip
	Vanta.Whitelist(Player, 2, {"AntiTeleport", "AntiNoclip"})

	-- whitelist a single module
	Vanta.Whitelist(Player, 1, "AntiSpeed")

	Call it right BEFORE moving the player.

	Modules that are disabled in the settings above are skipped automatically.
	If a disabled module is enabled later, it will also support whitelisting.
--]]

function Api.Whitelist(Player, Duration, Only)
	if typeof(Player) ~= "Instance" or not Player:IsA("Player") then
		return
	end

	Duration = tonumber(Duration) or 1

	local Modules = script:FindFirstChild("Modules")

	if not Modules then
		return
	end

	local Targets = WhitelistModules

	if typeof(Only) == "string" then
		Targets = { Only }
	elseif typeof(Only) == "table" then
		Targets = Only
	end

	for _, Name in ipairs(Targets) do
		if not table.find(WhitelistModules, Name) then
			warn("[Vanta] Whitelist: unknown module '" .. tostring(Name) .. "'")
			continue
		end

		local ModuleScript = Modules:FindFirstChild(Name)

		if ModuleScript and ModuleScript:IsA("ModuleScript") then
			local Success, Module = pcall(require, ModuleScript)

			if Success
				and typeof(Module) == "table"
				and typeof(Module.Whitelist) == "function" then

				Module.Whitelist(Player, Duration)
			end
		end
	end
end

return setmetatable(Settings, {
	__index = Api,
})]]></ProtectedString>
