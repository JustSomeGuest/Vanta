					<ProtectedString name="Source"><![CDATA[local AntiTeleport = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Vanta = script.Parent.Parent
local Settings = require(Vanta)
local Config = Settings.AntiTeleport

local Kick = require(script.Parent.Kick)
local Notify = require(script.Parent.Notify)

if not Config.Enabled then
	return AntiTeleport
end

local StrikeLimit = Config.StrikeLimit or 3
local StrikeCooldown = Config.StrikeCooldown or 5
local StrikeDecayTime = Config.StrikeDecayTime or 30
local SpawnGrace = Config.SpawnGrace or 1.5

local ExtraDistance = Config.ExtraDistance or 10

local SpeedTolerance = Config.SpeedTolerance or 1.5

local MaxTrustedSpeed = Config.MaxTrustedSpeed or 120
local MaxPhysicsSpeed = Config.MaxPhysicsSpeed or 150
local MaxFallSpeed = Config.MaxFallSpeed or 500
local BaseFallSpeed = Config.BaseFallSpeed or 30

local QuietWindow = Config.QuietWindow or 0.15
local MaxLagWindow = Config.MaxLagWindow or 1

local Debug = Config.Debug == true

local HardExempt = {
	[Enum.HumanoidStateType.Seated] = true,
}

local SoftStates = {
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
}

local Connections = {}
local WhitelistUntil = {}

local function GetJumpVelocity(Humanoid)
	if Humanoid.UseJumpPower then
		return Humanoid.JumpPower
	end

	return math.sqrt(2 * Workspace.Gravity * Humanoid.JumpHeight)
end

local function Snap(RootPart, CFrameValue)
	RootPart.CFrame = CFrameValue
	RootPart.AssemblyLinearVelocity = Vector3.zero
	RootPart.AssemblyAngularVelocity = Vector3.zero
end

function AntiTeleport.Whitelist(Player, Duration)
	if not Player then
		return
	end

	local Until = os.clock() + (Duration or 1)

	if not WhitelistUntil[Player] or Until > WhitelistUntil[Player] then
		WhitelistUntil[Player] = Until
	end
end

local function IsWhitelisted(Player)
	local Until = WhitelistUntil[Player]

	if not Until then
		return false
	end

	if os.clock() >= Until then
		WhitelistUntil[Player] = nil
		return false
	end

	return true
end

local function SetupPlayer(Player)
	local CurrentCharacter = nil
	local SpawnTime = os.clock()

	local LastPosition = nil
	local LastCFrame = nil
	local LastChangeTime = 0
	local LastHorizontalSpeed = 0
	local LastVerticalSpeed = 0

	local Strikes = 0
	local LastStrikeTime = 0
	local LastStrikeDecay = os.clock()

	local LogTimes = {}

	local function Log(Tag, ...)
		if not Debug then
			return
		end

		local Now = os.clock()

		if LogTimes[Tag] and Now - LogTimes[Tag] < 0.5 then
			return
		end

		LogTimes[Tag] = Now

		warn("[Vanta AntiTeleport] " .. Player.Name .. ": " .. Tag, ...)
	end

	local function ResetTracking()
		LastPosition = nil
		LastCFrame = nil
		LastChangeTime = os.clock()
		LastHorizontalSpeed = 0
		LastVerticalSpeed = 0
		LastStrikeDecay = os.clock()
	end

	local function Sample(CFrameValue, Velocity)
		LastPosition = CFrameValue.Position
		LastCFrame = CFrameValue
		LastChangeTime = os.clock()

		LastHorizontalSpeed = math.min(
			Vector3.new(Velocity.X, 0, Velocity.Z).Magnitude,
			MaxTrustedSpeed
		)

		LastVerticalSpeed = math.clamp(Velocity.Y, -MaxFallSpeed, MaxTrustedSpeed)
	end

	local function DecayStrikes(Now)
		if Strikes > 0 and Now - LastStrikeDecay >= StrikeDecayTime then
			Strikes -= 1
			LastStrikeDecay = Now
		end
	end

	local function OnCharacterAdded(Character)
		CurrentCharacter = Character
		SpawnTime = os.clock()

		Strikes = 0
		LastStrikeTime = 0

		ResetTracking()
	end

	Player.CharacterAdded:Connect(OnCharacterAdded)

	if Player.Character then
		OnCharacterAdded(Player.Character)
	end

	Connections[Player] = RunService.Heartbeat:Connect(function()
		local Character = Player.Character

		if not Character or Character ~= CurrentCharacter then
			return
		end

		local RootPart = Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")

		if not RootPart or not Humanoid then
			ResetTracking()
			return
		end

		local Now = os.clock()
		local CurrentCFrame = RootPart.CFrame
		local CurrentPosition = CurrentCFrame.Position
		local Velocity = RootPart.AssemblyLinearVelocity
		local State = Humanoid:GetState()

		if Now - SpawnTime < SpawnGrace
			or Humanoid.Health <= 0
			or HardExempt[State]
			or IsWhitelisted(Player) then

			Sample(CurrentCFrame, Velocity)
			LastStrikeDecay = Now
			return
		end

		if not LastPosition then
			Sample(CurrentCFrame, Velocity)
			return
		end

		local Delta = CurrentPosition - LastPosition

		if Delta.Magnitude <= 0.001 then
			DecayStrikes(Now)
			return
		end

		local Soft = SoftStates[State] == true

		local HorizontalSpeed
		local UpSpeed
		local DownSpeed

		if Soft then
			HorizontalSpeed = MaxPhysicsSpeed
			UpSpeed = MaxPhysicsSpeed
			DownSpeed = MaxPhysicsSpeed
		else
			HorizontalSpeed = math.max(Humanoid.WalkSpeed, LastHorizontalSpeed) * SpeedTolerance

			UpSpeed = math.max(
				GetJumpVelocity(Humanoid),
				math.max(LastVerticalSpeed, 0)
			) * SpeedTolerance

			DownSpeed = math.clamp(
				-LastVerticalSpeed * SpeedTolerance,
				BaseFallSpeed,
				MaxFallSpeed
			)
		end

		local Moving = Soft
			or LastHorizontalSpeed > 1
			or math.abs(LastVerticalSpeed) > 1

		local Window = math.min(
			Now - LastChangeTime,
			Moving and MaxLagWindow or QuietWindow
		)

		local Horizontal = Vector3.new(Delta.X, 0, Delta.Z).Magnitude
		local Up = math.max(Delta.Y, 0)
		local Down = math.max(-Delta.Y, 0)

		local Reason = nil

		if Horizontal > HorizontalSpeed * Window + ExtraDistance then
			Reason = string.format("horizontal jump of %.1f studs", Horizontal)
		elseif Up > UpSpeed * Window + ExtraDistance then
			Reason = string.format("upward jump of %.1f studs", Up)
		elseif Down > DownSpeed * Window + ExtraDistance then
			Reason = string.format("downward jump of %.1f studs", Down)
		end

		if not Reason then
			Sample(CurrentCFrame, Velocity)
			DecayStrikes(Now)
			return
		end

		Log("teleport", Reason)

		Snap(RootPart, LastCFrame)
		Sample(LastCFrame, Vector3.zero)

		if Now - LastStrikeTime >= StrikeCooldown then
			LastStrikeTime = Now
			LastStrikeDecay = Now
			Strikes += 1

			if Strikes >= StrikeLimit then
				Kick:Init(Player, "AntiTeleport")
				ResetTracking()
				return
			end

			Notify:Send(Player, "AntiTeleport")
		end
	end)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(Player)
	if Connections[Player] then
		Connections[Player]:Disconnect()
		Connections[Player] = nil
	end

	WhitelistUntil[Player] = nil
end)

for _, Player in ipairs(Players:GetPlayers()) do
	SetupPlayer(Player)
end

return AntiTeleport]]></ProtectedString>
