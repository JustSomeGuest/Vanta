					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local AntiBackdoor = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local Kick = require(script.Parent.Kick)

local Characters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()-_=+;:',.<>/?|`~"
local SafeCharacters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

local CreatedEvents = {}

local function Randomize(Length, Safe)
	local CharacterSet = Safe and SafeCharacters or Characters
	local String = ""

	for _ = 1, Length do
		local Index = math.random(1, #CharacterSet)
		String ..= CharacterSet:sub(Index, Index)
	end

	return String
end

local function GetRandomContainer(Parent)
	local Valid = {}

	for _, Object in ipairs(Parent:GetDescendants()) do
		if Object:IsA("Folder")
			or Object:IsA("Model")
			or Object:IsA("Configuration") then

			table.insert(Valid, Object)
		end
	end

	if #Valid > 0 then
		return Valid[math.random(1, #Valid)]
	end

	return Parent
end

local function ObfuscateRemote(Remote)
	Remote.Name = Randomize(math.random(32, 64))

	Remote:SetAttribute(
		Randomize(8, true),
		HttpService:GenerateGUID(false)
	)

	Remote:SetAttribute(
		Randomize(10, true),
		Randomize(20)
	)

	Remote:SetAttribute(
		Randomize(12, true),
		math.random(100000, 999999)
	)

	Remote:SetAttribute(
		Randomize(14, true),
		os.clock()
	)

	Remote.Archivable = false
end

local function RemoveCreatedEvent(Remote)
	for Index = #CreatedEvents, 1, -1 do
		if CreatedEvents[Index] == Remote then
			table.remove(CreatedEvents, Index)
			return
		end
	end
end

local function CreateTrapRemote(Parent)
	local Container = GetRandomContainer(Parent)
	local Remote = Instance.new("RemoteEvent")

	ObfuscateRemote(Remote)

	Remote.Parent = Container

	Remote.OnServerEvent:Connect(function(Player)
		if not Player or not Player:IsA("Player") then
			return
		end

		Kick:Init(Player, "AntiBackdoor")
	end)

	Remote.AncestryChanged:Connect(function(_, NewParent)
		if NewParent then
			return
		end

		RemoveCreatedEvent(Remote)

		task.defer(function()
			CreateTrapRemote(Parent)
		end)
	end)

	table.insert(CreatedEvents, Remote)

	return Remote
end

CreateTrapRemote(Workspace)
CreateTrapRemote(ReplicatedStorage)

task.spawn(function()
	while true do
		task.wait(math.random(30, 90))

		for Index = #CreatedEvents, 1, -1 do
			local Remote = CreatedEvents[Index]

			if not Remote or not Remote.Parent then
				table.remove(CreatedEvents, Index)

				CreateTrapRemote(
					math.random(1, 2) == 1
						and Workspace
						or ReplicatedStorage
				)
			end
		end
	end
end)

return AntiBackdoor]]></ProtectedString>
