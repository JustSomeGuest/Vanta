					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local AntiTeleport = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Vanta = script.Parent.Parent
local Settings = require(Vanta)
local Config = Settings.AntiTeleport

local Kick = require(script.Parent.Kick)
local Notify = require(script.Parent.Notify)

if not Config.Enabled then
	return AntiTeleport
end

local MaxDistance = Config.MaxTeleportDistance or 40
local StrikeLimit = Config.StrikeLimit or 3
local StrikeCooldown = Config.StrikeCooldown or 5
local StrikeDecayTime = Config.StrikeDecayTime or 30
local SpawnGrace = Config.SpawnGrace or 1.5
local MaxPhysicsDistance = Config.MaxPhysicsDistance or 15

local ExemptStates = {
	[Enum.HumanoidStateType.Seated] = true,
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.Swimming] = true,
	[Enum.HumanoidStateType.Climbing] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
}

local Connections = {}
local WhitelistUntil = {}

function AntiTeleport.Whitelist(Player, Duration)
	if not Player then
		return
	end

	local Until = os.clock() + (Duration or 1)

	if not WhitelistUntil[Player] or Until > WhitelistUntil[Player] then
		WhitelistUntil[Player] = Until
	end
end

local function IsWhitelisted(Player)
	local Until = WhitelistUntil[Player]

	if not Until then
		return false
	end

	if os.clock() >= Until then
		WhitelistUntil[Player] = nil
		return false
	end

	return true
end

local function SetupPlayer(Player)
	local LastPosition = nil
	local LastCFrame = nil

	local SpawnTime = os.clock()
	local CurrentCharacter = nil

	local Strikes = 0
	local LastStrikeTime = 0
	local LastStrikeDecay = os.clock()

	local function OnCharacterAdded(Character)
		CurrentCharacter = Character

		LastPosition = nil
		LastCFrame = nil

		SpawnTime = os.clock()

		Strikes = 0
		LastStrikeTime = 0
		LastStrikeDecay = os.clock()
	end

	Player.CharacterAdded:Connect(OnCharacterAdded)

	if Player.Character then
		OnCharacterAdded(Player.Character)
	end

	Connections[Player] = RunService.Heartbeat:Connect(function(DeltaTime)
		local Character = Player.Character

		if Character ~= CurrentCharacter then
			return
		end

		local RootPart = Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")

		if not RootPart or not Humanoid then
			LastPosition = nil
			LastCFrame = nil
			return
		end

		local Now = os.clock()

		if Now - SpawnTime < SpawnGrace then
			LastPosition = RootPart.Position
			LastCFrame = RootPart.CFrame
			LastStrikeDecay = Now
			return
		end

		if IsWhitelisted(Player) then
			LastPosition = RootPart.Position
			LastCFrame = RootPart.CFrame
			LastStrikeDecay = Now
			return
		end

		local State = Humanoid:GetState()

		if ExemptStates[State] then
			LastPosition = RootPart.Position
			LastCFrame = RootPart.CFrame
			LastStrikeDecay = Now
			return
		end

		if not LastPosition or not LastCFrame then
			LastPosition = RootPart.Position
			LastCFrame = RootPart.CFrame
			return
		end

		local CurrentPosition = RootPart.Position

		local Distance =
			(CurrentPosition - LastPosition).Magnitude

		local HorizontalDistance = Vector3.new(
			CurrentPosition.X - LastPosition.X,
			0,
			CurrentPosition.Z - LastPosition.Z
		).Magnitude

		local VerticalDistance = math.abs(
			CurrentPosition.Y - LastPosition.Y
		)

		local Velocity = RootPart.AssemblyLinearVelocity

		local HorizontalVelocity = Vector3.new(
			Velocity.X,
			0,
			Velocity.Z
		).Magnitude

		local ExpectedPhysicsDistance = math.max(
			MaxPhysicsDistance,
			HorizontalVelocity * DeltaTime * 2 + 8
		)

		local Teleported = false

		if Distance > MaxDistance then
			Teleported = true
		elseif HorizontalDistance > MaxDistance then
			Teleported = true
		elseif VerticalDistance > MaxDistance then
			Teleported = true
		elseif Distance > ExpectedPhysicsDistance
			and Distance > MaxPhysicsDistance then

			Teleported = true
		end

		if Teleported then
			RootPart.CFrame = LastCFrame
			RootPart.AssemblyLinearVelocity = Vector3.zero
			RootPart.AssemblyAngularVelocity = Vector3.zero

			LastPosition = LastCFrame.Position
			LastCFrame = LastCFrame

			if Now - LastStrikeTime >= StrikeCooldown then
				LastStrikeTime = Now
				Strikes += 1

				if Strikes >= StrikeLimit then
					Kick:Init(Player, "AntiTeleport")

					LastPosition = nil
					LastCFrame = nil

					return
				end

				Notify:Send(Player, "AntiTeleport")
			end

			return
		end

		LastPosition = CurrentPosition
		LastCFrame = RootPart.CFrame

		if Strikes > 0
			and Now - LastStrikeDecay >= StrikeDecayTime then

			Strikes -= 1
			LastStrikeDecay = Now
		end
	end)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(Player)
	if Connections[Player] then
		Connections[Player]:Disconnect()
		Connections[Player] = nil
	end

	WhitelistUntil[Player] = nil
end)

for _, Player in ipairs(Players:GetPlayers()) do
	SetupPlayer(Player)
end

return AntiTeleport]]></ProtectedString>
					<string name="ScriptGuid">{3656F7A2-034D-4089-AECB-18CEEBC47C21}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">AntiTeleport</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
