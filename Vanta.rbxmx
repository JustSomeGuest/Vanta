				<Properties>
					<ProtectedString name="Source"><![CDATA[if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
local Remote = ReplicatedStorage:WaitForChild("VNT_ClientHB")

local CurrentSequence
local CurrentChallenge
local Sending = false

local WatchedObjects = {}

local function Report(Action, Object)
	if Remote and Remote.Parent then
		Remote:FireServer(
			Action,
			Object and Object.Name
		)
	end
end

local function WatchScript(Object)
	if not Object:IsA("LocalScript")
		and not Object:IsA("ModuleScript") then
		return
	end

	if Object == script or WatchedObjects[Object] then
		return
	end

	WatchedObjects[Object] = true

	Object.AncestryChanged:Connect(function(_, Parent)
		if not Parent then
			Report("ScriptDeleted", Object)
		end
	end)
end

local function WatchRemote(Object)
	if not Object:IsA("RemoteEvent")
		and not Object:IsA("UnreliableRemoteEvent")
		and not Object:IsA("RemoteFunction") then
		return
	end

	if Object == Remote or WatchedObjects[Object] then
		return
	end

	WatchedObjects[Object] = true

	Object.AncestryChanged:Connect(function(_, Parent)
		if not Parent then
			Report("RemoteDeleted", Object)
		end
	end)
end

local function WatchObject(Object)
	WatchScript(Object)
	WatchRemote(Object)
end

for _, Object in ipairs(PlayerScripts:GetDescendants()) do
	WatchObject(Object)
end

for _, Object in ipairs(ReplicatedFirst:GetDescendants()) do
	WatchObject(Object)
end

for _, Object in ipairs(ReplicatedStorage:GetDescendants()) do
	WatchObject(Object)
end

PlayerScripts.DescendantAdded:Connect(WatchObject)
ReplicatedFirst.DescendantAdded:Connect(WatchObject)
ReplicatedStorage.DescendantAdded:Connect(WatchObject)

task.spawn(function()
	local Gui = PlayerGui:WaitForChild("VNT_Notifications", 30)

	if not Gui then
		return
	end

	local Connection

	Connection = Gui.AncestryChanged:Connect(function(_, Parent)
		if not Gui:IsDescendantOf(PlayerGui) then
			Connection:Disconnect()
			Report("GuiDeleted", Gui)
		end
	end)
end)

local function GetValidCount()
	local Count = 0

	for Object in pairs(WatchedObjects) do
		if Object and Object.Parent then
			Count += 1
		end
	end

	return Count
end

Remote.OnClientEvent:Connect(function(Action, Sequence, Challenge)
	if Action ~= "Challenge" then
		return
	end

	if typeof(Sequence) ~= "number"
		or typeof(Challenge) ~= "string" then
		return
	end

	if CurrentSequence ~= nil and Sequence ~= CurrentSequence + 1 then
		return
	end

	CurrentSequence = Sequence
	CurrentChallenge = Challenge
end)

task.spawn(function()
	while true do
		task.wait(0.1)

		if Sending then
			continue
		end

		if CurrentSequence == nil or CurrentChallenge == nil then
			continue
		end

		Sending = true

		local Sequence = CurrentSequence
		local Challenge = CurrentChallenge

		CurrentChallenge = nil

		local ValidCount = GetValidCount()

		Remote:FireServer(
			"Heartbeat",
			Sequence,
			Challenge,
			ValidCount
		)

		Sending = false

		task.wait(0.9)
	end
end)]]></ProtectedString>
