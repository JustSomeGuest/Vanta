					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Notify = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remote = ReplicatedStorage:FindFirstChild("VNT_Notify")

if not Remote then
	Remote = Instance.new("RemoteEvent")
	Remote.Name = "VNT_Notify"
	Remote.Archivable = false
	Remote.Parent = ReplicatedStorage
end

local DEFAULT_TITLE = "Vanta Detection"
local DEFAULT_DURATION = 4
local DEFAULT_SEVERITY = "warn"
local DEDUPE_WINDOW = 1

local Severities = {
	info = true,
	warn = true,
	danger = true,
}

local LastSent = {}

Players.PlayerRemoving:Connect(function(Player)
	LastSent[Player] = nil
end)

function Notify:Send(Player, Detection, Duration, Severity)
	if not Player or not Player:IsA("Player") then
		return
	end

	if typeof(Detection) ~= "string" or Detection == "" then
		return
	end

	Duration = tonumber(Duration) or DEFAULT_DURATION
	Duration = math.clamp(Duration, 1, 10)

	if typeof(Severity) ~= "string" or not Severities[Severity] then
		Severity = DEFAULT_SEVERITY
	end

	local Now = os.clock()
	local PlayerLog = LastSent[Player]

	if not PlayerLog then
		PlayerLog = {}
		LastSent[Player] = PlayerLog
	end

	local Last = PlayerLog[Detection]

	if Last and Now - Last < DEDUPE_WINDOW then
		return
	end

	PlayerLog[Detection] = Now

	if Remote and Remote.Parent then
		Remote:FireClient(
			Player,
			DEFAULT_TITLE,
			Detection,
			Duration,
			Severity
		)
	end
end

return Notify]]></ProtectedString>
