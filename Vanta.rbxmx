					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local AntiSpeed = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Vanta = script.Parent.Parent
local Settings = require(Vanta)
local Config = Settings.AntiSpeed

local Kick = require(script.Parent.Kick)
local Notify = require(script.Parent.Notify)

if not Config.Enabled then
	return AntiSpeed
end

local AllowedSpeeds = Config.AllowedSpeeds or {16}

local StrikeLimit = Config.StrikeLimit or 3
local StrikeCooldown = Config.StrikeCooldown or 5
local StrikeDecayTime = Config.StrikeDecayTime or 30
local SpawnGrace = Config.SpawnGrace or 1.5

-- Extra studs a player may be "over budget" before being flagged
local ExtraDistance = Config.ExtraDistance or 5

-- How many seconds of movement a laggy player may catch up on at once
local LagAllowance = Config.LagAllowance or 1

-- Extra speed allowed while jumping or falling
local AirborneSpeed = Config.AirborneSpeed or 4

-- Speed allowed while ragdolled, flung or otherwise physics-driven
local PhysicsSpeed = Config.PhysicsSpeed or 120

-- Single-frame moves bigger than this are teleports, which AntiTeleport handles
local MaxStepDistance = Config.MaxStepDistance or 40

-- Checks are skipped while the player's ping (in seconds) is higher than this
local MaxPing = Config.MaxPing or 0.4

local FloorCheckDistance = 10

local Debug = Config.Debug == true

local HardExempt = {
	[Enum.HumanoidStateType.Seated] = true,
}

local SoftStates = {
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
}

local FloorParams = RaycastParams.new()
FloorParams.FilterType = Enum.RaycastFilterType.Exclude
FloorParams.IgnoreWater = true

local Connections = {}
local WhitelistUntil = {}

local function GetConfiguredSpeeds()
	local Speeds = {}

	for _, Value in ipairs(AllowedSpeeds) do
		local Speed = tonumber(Value)

		if Speed and Speed > 0 then
			table.insert(Speeds, Speed)
		end
	end

	if #Speeds == 0 then
		Speeds[1] = 16
	end

	table.sort(Speeds)

	return Speeds
end

local ConfiguredSpeeds = GetConfiguredSpeeds()
local DefaultSpeed = ConfiguredSpeeds[1]
local FullBudget = ConfiguredSpeeds[#ConfiguredSpeeds] * LagAllowance

local function IsConfiguredWalkSpeed(Speed)
	for _, AllowedSpeed in ipairs(ConfiguredSpeeds) do
		if math.abs(Speed - AllowedSpeed) <= 0.05 then
			return true
		end
	end

	return false
end

local function Snap(RootPart, CFrameValue)
	RootPart.CFrame = CFrameValue
	RootPart.AssemblyLinearVelocity = Vector3.zero
	RootPart.AssemblyAngularVelocity = Vector3.zero
end

function AntiSpeed.Whitelist(Player, Duration)
	if not Player then
		return
	end

	local Until = os.clock() + (Duration or 1)

	if not WhitelistUntil[Player] or Until > WhitelistUntil[Player] then
		WhitelistUntil[Player] = Until
	end
end

local function IsWhitelisted(Player)
	local Until = WhitelistUntil[Player]

	if not Until then
		return false
	end

	if os.clock() >= Until then
		WhitelistUntil[Player] = nil
		return false
	end

	return true
end

local function SetupPlayer(Player)
	local CurrentCharacter = nil
	local SpawnTime = os.clock()

	local LastPosition = nil
	local LastGoodCFrame = nil

	-- distance the player has earned but not yet used (negative = over budget)
	local Budget = FullBudget

	local FloorPart = nil
	local FloorPosition = nil

	local Strikes = 0
	local LastStrikeTime = 0
	local LastStrikeDecay = os.clock()

	local LogTimes = {}

	local function Log(Tag, ...)
		if not Debug then
			return
		end

		local Now = os.clock()

		if LogTimes[Tag] and Now - LogTimes[Tag] < 0.5 then
			return
		end

		LogTimes[Tag] = Now

		warn("[Vanta AntiSpeed] " .. Player.Name .. ": " .. Tag, ...)
	end

	local function ResetTracking()
		LastPosition = nil
		LastGoodCFrame = nil
		Budget = FullBudget
		FloorPart = nil
		FloorPosition = nil
		LastStrikeDecay = os.clock()
	end

	local function Rebase(CFrameValue)
		LastPosition = CFrameValue.Position
		LastGoodCFrame = CFrameValue
		Budget = FullBudget
		FloorPart = nil
		FloorPosition = nil
	end

	local function DecayStrikes(Now)
		if Strikes > 0 and Now - LastStrikeDecay >= StrikeDecayTime then
			Strikes -= 1
			LastStrikeDecay = Now
		end
	end

	local function Flag(Now)
		if Now - LastStrikeTime < StrikeCooldown then
			return
		end

		LastStrikeTime = Now
		LastStrikeDecay = Now
		Strikes += 1

		if Strikes >= StrikeLimit then
			Kick:Init(Player, "AntiSpeed")
			ResetTracking()
			return
		end

		Notify:Send(Player, "AntiSpeed")
	end

	local function OnCharacterAdded(Character)
		CurrentCharacter = Character
		SpawnTime = os.clock()

		Strikes = 0
		LastStrikeTime = 0

		ResetTracking()
	end

	Player.CharacterAdded:Connect(OnCharacterAdded)

	if Player.Character then
		OnCharacterAdded(Player.Character)
	end

	Connections[Player] = RunService.Heartbeat:Connect(function(DeltaTime)
		local Character = Player.Character

		if not Character or Character ~= CurrentCharacter then
			return
		end

		local RootPart = Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")

		if not RootPart or not Humanoid then
			ResetTracking()
			return
		end

		local Now = os.clock()
		local State = Humanoid:GetState()

		if Now - SpawnTime < SpawnGrace
			or Humanoid.Health <= 0
			or HardExempt[State]
			or IsWhitelisted(Player) then

			Rebase(RootPart.CFrame)
			LastStrikeDecay = Now
			return
		end

		-- the server-side WalkSpeed must be one of the allowed speeds
		if not IsConfiguredWalkSpeed(Humanoid.WalkSpeed) then
			Log("walk speed not allowed", Humanoid.WalkSpeed)

			Humanoid.WalkSpeed = DefaultSpeed
			Rebase(RootPart.CFrame)
			Flag(Now)
			return
		end

		if not LastPosition then
			Rebase(RootPart.CFrame)
			return
		end

		if Player:GetNetworkPing() > MaxPing then
			Log("high ping, skipping")
			Rebase(RootPart.CFrame)
			return
		end

		local Position = RootPart.Position
		local Delta = Position - LastPosition
		local Step = Vector3.new(Delta.X, 0, Delta.Z).Magnitude

		LastPosition = Position

		if Step > MaxStepDistance then
			Rebase(RootPart.CFrame)
			return
		end

		local Rate = SoftStates[State] and PhysicsSpeed or Humanoid.WalkSpeed

		if State == Enum.HumanoidStateType.Jumping
			or State == Enum.HumanoidStateType.Freefall then

			Rate += AirborneSpeed
		end

		-- earn distance for this frame, then spend what was actually moved
		Budget = math.min(Budget + Rate * DeltaTime, Rate * LagAllowance) - Step

		if Budget < 0 then
			-- moving platforms and conveyors carry the player: that movement is free
			FloorParams.FilterDescendantsInstances = {Character}

			local Hit = Workspace:Raycast(
				Position,
				Vector3.new(0, -FloorCheckDistance, 0),
				FloorParams
			)

			local Part = Hit and Hit.Instance

			if Part and Part == FloorPart then
				local Move = Part.Position - FloorPosition
				local Moved = Vector3.new(Move.X, 0, Move.Z).Magnitude

				local Velocity = Part.AssemblyLinearVelocity
				local Carried = Vector3.new(Velocity.X, 0, Velocity.Z).Magnitude * DeltaTime

				Budget = math.min(Budget + math.max(Moved, Carried), 0)
			end

			FloorPart = Part
			FloorPosition = Part and Part.Position
		else
			FloorPart = nil
			FloorPosition = nil

			LastGoodCFrame = RootPart.CFrame
			DecayStrikes(Now)
		end

		if -Budget <= ExtraDistance then
			return
		end

		Log("speeding", string.format("%.1f studs over budget", -Budget))

		Snap(RootPart, LastGoodCFrame)
		Rebase(LastGoodCFrame)

