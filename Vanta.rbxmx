		}):Play()
	end)

	Card.MouseLeave:Connect(function()
		if Notif.Dismissed then
			return
		end

		TweenService:Create(Card, HoverInfo, {
			BackgroundColor3 = CARD_COLOR
		}):Play()

		TweenService:Create(Stroke, HoverInfo, {
			Transparency = 0.78
		}):Play()
	end)

	Card.Activated:Connect(function()
		Dismiss(Notif)
	end)

	task.delay(Duration, Dismiss, Notif)
end

