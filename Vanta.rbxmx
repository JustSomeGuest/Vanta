					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local AntiSpeed = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Vanta = script.Parent.Parent
local Settings = require(Vanta)
local Config = Settings.AntiSpeed

local Kick = require(script.Parent.Kick)
local Notify = require(script.Parent.Notify)

if not Config.Enabled then
	return AntiSpeed
end

local AllowedSpeeds = Config.AllowedSpeeds or {16}

local StrikeLimit = Config.StrikeLimit or 3
local StrikeCooldown = Config.StrikeCooldown or 5
local StrikeDecayTime = Config.StrikeDecayTime or 30

local SpawnGrace = Config.SpawnGrace or 1.5
local CheckInterval = Config.CheckInterval or 0.25

local SpeedTolerance = Config.SpeedTolerance or 3
local AirborneTolerance = Config.AirborneTolerance or 8

local RequiredViolations = Config.RequiredViolations or 3
local ViolationDecay = Config.ViolationDecay or 1

local MaxTeleportDistance = Config.MaxTeleportDistance or 40

local Connections = {}
local WhitelistUntil = {}

local GeneralExemptStates = {
	[Enum.HumanoidStateType.Seated] = true,
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.Swimming] = true,
	[Enum.HumanoidStateType.Climbing] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
}

local function GetConfiguredSpeeds()
	local Speeds = {}

	for _, Value in ipairs(AllowedSpeeds) do
		local Speed = tonumber(Value)

		if Speed and Speed > 0 then
			table.insert(Speeds, Speed)
		end
	end

	if #Speeds == 0 then
		Speeds[1] = 16
	end

	table.sort(Speeds)

	return Speeds
end

local ConfiguredSpeeds = GetConfiguredSpeeds()

local function GetMaximumAllowedSpeed()
	return ConfiguredSpeeds[#ConfiguredSpeeds]
end

local function IsConfiguredWalkSpeed(Speed)
	for _, AllowedSpeed in ipairs(ConfiguredSpeeds) do
		if math.abs(Speed - AllowedSpeed) <= 0.05 then
			return true
		end
	end

	return false
end

local function GetDefaultSpeed()
	return ConfiguredSpeeds[1]
end

local function GetHorizontalSpeed(FromPosition, ToPosition, DeltaTime)
	if DeltaTime <= 0 then
		return 0
	end

	local Delta = ToPosition - FromPosition

	local HorizontalDistance = Vector3.new(
		Delta.X,
		0,
		Delta.Z
	).Magnitude

	return HorizontalDistance / DeltaTime
end

local function IsWhitelisted(Player)
	local Until = WhitelistUntil[Player]

	if not Until then
		return false
	end

	if os.clock() >= Until then
		WhitelistUntil[Player] = nil
		return false
	end

	return true
end

function AntiSpeed.Whitelist(Player, Duration)
	if not Player then
		return
	end

	local Until = os.clock() + (Duration or 1)

	if not WhitelistUntil[Player] or Until > WhitelistUntil[Player] then
		WhitelistUntil[Player] = Until
	end
end

local function SetupPlayer(Player)
	local LastPosition = nil
	local Accumulator = 0
	local SpawnTime = os.clock()
	local CurrentCharacter = nil

	local Strikes = 0
	local LastStrikeTime = 0
	local LastStrikeDecay = os.clock()

	local Violations = 0

	local function OnCharacterAdded(Character)
		CurrentCharacter = Character
		LastPosition = nil
		Accumulator = 0
		SpawnTime = os.clock()

		Strikes = 0
		LastStrikeTime = 0
		LastStrikeDecay = os.clock()

		Violations = 0
	end

	Player.CharacterAdded:Connect(OnCharacterAdded)

	if Player.Character then
		OnCharacterAdded(Player.Character)
	end

	Connections[Player] = RunService.Heartbeat:Connect(function(DeltaTime)
		local Character = Player.Character

		if Character ~= CurrentCharacter then
			return
		end

		local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if not RootPart or not Humanoid then
			LastPosition = nil
			Accumulator = 0
			Violations = 0
			return
		end

		local Now = os.clock()

		if Now - SpawnTime < SpawnGrace then
			LastPosition = RootPart.Position
			Accumulator = 0
			Violations = 0
			LastStrikeDecay = Now
			return
		end

		if IsWhitelisted(Player) then
			LastPosition = RootPart.Position
			Accumulator = 0
			Violations = 0
			LastStrikeDecay = Now
			return
		end

		local State = Humanoid:GetState()

		if GeneralExemptStates[State] then
			LastPosition = RootPart.Position
			Accumulator = 0
			Violations = 0
			LastStrikeDecay = Now
			return
		end

		if not IsConfiguredWalkSpeed(Humanoid.WalkSpeed) then
			Humanoid.WalkSpeed = GetDefaultSpeed()

			LastPosition = RootPart.Position
			Accumulator = 0
			Violations += 1

			if Violations >= RequiredViolations then
				local StrikeNow = os.clock()

				if StrikeNow - LastStrikeTime >= StrikeCooldown then
					LastStrikeTime = StrikeNow
					Strikes += 1
					Violations = 0

					if Strikes >= StrikeLimit then
						Kick:Init(Player, "AntiSpeed")
						return
					end

					Notify:Send(Player, "AntiSpeed")
				end
			end

			return
		end

		if not LastPosition then
			LastPosition = RootPart.Position
			return
		end

		Accumulator += DeltaTime

		if Accumulator < CheckInterval then
			return
		end

		local CurrentPosition = RootPart.Position
		local Elapsed = Accumulator

		Accumulator = 0

		local Distance = (CurrentPosition - LastPosition).Magnitude

		if Distance > MaxTeleportDistance then
			LastPosition = CurrentPosition
			Violations = 0
			LastStrikeDecay = Now
			return
		end

		local Speed = GetHorizontalSpeed(
			LastPosition,
			CurrentPosition,
			Elapsed
		)

		LastPosition = CurrentPosition

		local AllowedSpeed = GetMaximumAllowedSpeed()
		local Tolerance = SpeedTolerance

		if State == Enum.HumanoidStateType.Jumping
			or State == Enum.HumanoidStateType.Freefall then

			Tolerance += AirborneTolerance
		end

		local SpeedLimit = AllowedSpeed + Tolerance

		if Speed > SpeedLimit then
			Violations += 1
		else
			Violations = math.max(
				0,
				Violations - ViolationDecay
			)
		end

		if Violations >= RequiredViolations then
			local StrikeNow = os.clock()

			if StrikeNow - LastStrikeTime >= StrikeCooldown then
				LastStrikeTime = StrikeNow
				Strikes += 1
				Violations = 0

				if Strikes >= StrikeLimit then
					Kick:Init(Player, "AntiSpeed")
					return
				end

				Notify:Send(Player, "AntiSpeed")
			else
				Violations = math.max(
					0,
					Violations - 1
				)
			end
		end

		if Strikes > 0
			and Now - LastStrikeDecay >= StrikeDecayTime then

			Strikes -= 1
			LastStrikeDecay = Now
		end
	end)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(Player)
	if Connections[Player] then
		Connections[Player]:Disconnect()
		Connections[Player] = nil
	end

	WhitelistUntil[Player] = nil
end)

for _, Player in ipairs(Players:GetPlayers()) do
	SetupPlayer(Player)
end

return AntiSpeed]]></ProtectedString>
