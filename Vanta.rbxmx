				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local AntiFly = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Vanta = script.Parent.Parent
local Settings = require(Vanta)
local Config = Settings.AntiFly

local Kick = require(script.Parent.Kick)
local Notify = require(script.Parent.Notify)

if not Config.Enabled then
	return AntiFly
end

local ExemptStates = {
	[Enum.HumanoidStateType.Seated] = true,
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.Swimming] = true,
	[Enum.HumanoidStateType.Climbing] = true,
}

local StrikeLimit = Config.StrikeLimit or 3
local StrikeCooldown = Config.StrikeCooldown or 5
local MaxAirTime = Config.MaxAirTime or 1.8
local GroundCheckDistance = 6
local StrikeDecayTime = 30
local RecoveryDelay = 0.25

local GroundRayParams = RaycastParams.new()
GroundRayParams.FilterType = Enum.RaycastFilterType.Exclude

local Connections = {}
local WhitelistUntil = {}

local function GetHipOffset(Humanoid, RootPart)
	return Humanoid.RigType == Enum.HumanoidRigType.R6
		and 3
		or (Humanoid.HipHeight + (RootPart.Size.Y / 2))
end

local function GetGroundPosition(Character, RootPart, Humanoid)
	GroundRayParams.FilterDescendantsInstances = {Character}

	local Result = Workspace:Raycast(
		RootPart.Position,
		Vector3.new(0, -GroundCheckDistance, 0),
		GroundRayParams
	)

	if not Result then
		return nil
	end

	local HipOffset = GetHipOffset(Humanoid, RootPart)

	return Vector3.new(
		RootPart.Position.X,
		Result.Position.Y + HipOffset,
		RootPart.Position.Z
	)
end

local function FindFloorBelow(Character, RootPart, Humanoid)
	GroundRayParams.FilterDescendantsInstances = {Character}

	local Result = Workspace:Raycast(
		RootPart.Position,
		Vector3.new(0, -1000, 0),
		GroundRayParams
	)

	if not Result then
		return nil
	end

	local HipOffset = GetHipOffset(Humanoid, RootPart)

	return Vector3.new(
		RootPart.Position.X,
		Result.Position.Y + HipOffset,
		Result.Position.Z
	)
end

function AntiFly.Whitelist(Player, Duration)
	if not Player then
		return
	end

	local Until = os.clock() + (Duration or 1)

	if not WhitelistUntil[Player] or Until > WhitelistUntil[Player] then
		WhitelistUntil[Player] = Until
	end
end

local function IsWhitelisted(Player)
	local Until = WhitelistUntil[Player]

	if not Until then
		return false
	end

	if os.clock() >= Until then
		WhitelistUntil[Player] = nil
		return false
	end

	return true
end

local function AddStrike(Player, CurrentStrikes)
	if CurrentStrikes >= StrikeLimit then
		return true
	end

	Notify:Send(
		Player,
		"AntiFly"
	)

	return false
end

local function SetupPlayer(Player)
	local LastGroundedPosition
	local AirTimeStart = 0
	local IsAirborne = false
	local SuspiciousTime = 0
	local SpawnTime = os.clock()
	local CurrentCharacter
	local Strikes = 0
	local LastStrikeTime = 0
	local LastGroundedTime = os.clock()
	local RecoveryUntil = 0

	local function OnCharacterAdded(Character)
		CurrentCharacter = Character
		LastGroundedPosition = nil
		AirTimeStart = 0
		IsAirborne = false
		SuspiciousTime = 0
		SpawnTime = os.clock()
		Strikes = 0
		LastStrikeTime = 0
		LastGroundedTime = os.clock()
		RecoveryUntil = 0
	end

	Player.CharacterAdded:Connect(OnCharacterAdded)

	if Player.Character then
		OnCharacterAdded(Player.Character)
	end

	Connections[Player] = RunService.Heartbeat:Connect(function(DeltaTime)
		local Character = Player.Character

		if Character ~= CurrentCharacter then
			return
		end

		local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if not RootPart or not Humanoid then
			LastGroundedPosition = nil
			IsAirborne = false
			SuspiciousTime = 0
			return
		end

		local Now = os.clock()

		if Now - SpawnTime < 1.5 or IsWhitelisted(Player) then
			LastGroundedPosition = RootPart.Position
			IsAirborne = false
			SuspiciousTime = 0
			LastGroundedTime = Now
			return
		end

		local State = Humanoid:GetState()

		if ExemptStates[State] then
			LastGroundedPosition = RootPart.Position
			IsAirborne = false
			SuspiciousTime = 0
			LastGroundedTime = Now
			return
		end

		local GroundPosition = GetGroundPosition(
			Character,
			RootPart,
			Humanoid
		)

		if GroundPosition then
			LastGroundedPosition = GroundPosition
			IsAirborne = false
			SuspiciousTime = 0
			LastGroundedTime = Now

			if Now - LastStrikeTime >= StrikeDecayTime then
				Strikes = math.max(0, Strikes - 1)
				LastStrikeTime = Now
			end

			return
		end

		if not IsAirborne then
			IsAirborne = true
			AirTimeStart = Now
			SuspiciousTime = 0
			return
		end

		local TimeAirborne = Now - AirTimeStart
		local VelocityY = RootPart.AssemblyLinearVelocity.Y

		if TimeAirborne > MaxAirTime and VelocityY >= -2 then
			SuspiciousTime += DeltaTime
		else
			SuspiciousTime = math.max(
				0,
				SuspiciousTime - DeltaTime
			)
		end

		if SuspiciousTime < RecoveryDelay then
			return
		end

		local TargetPosition =
			FindFloorBelow(Character, RootPart, Humanoid)
			or LastGroundedPosition

		if TargetPosition then
			RootPart.CFrame = CFrame.new(TargetPosition)
			RootPart.AssemblyLinearVelocity = Vector3.zero
			LastGroundedPosition = TargetPosition
		end

		IsAirborne = false
		AirTimeStart = 0
		SuspiciousTime = 0
		RecoveryUntil = Now + RecoveryDelay

		if Now - LastStrikeTime >= StrikeCooldown then
			LastStrikeTime = Now
			Strikes += 1

			if Strikes >= StrikeLimit then
				Kick:Init(Player, "AntiFly")
				return
			end

			Notify:Send(
				Player,
				"AntiFly"
			)
		end
	end)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(Player)
	if Connections[Player] then
		Connections[Player]:Disconnect()
		Connections[Player] = nil
	end

	WhitelistUntil[Player] = nil
end)

for _, Player in Players:GetPlayers() do
	SetupPlayer(Player)
end

return AntiFly]]></ProtectedString>
