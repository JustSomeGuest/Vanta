				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Notify = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remote = ReplicatedStorage:FindFirstChild("VNT_Notify")

if not Remote then
	Remote = Instance.new("RemoteEvent")
	Remote.Name = "VNT_Notify"
	Remote.Archivable = false
	Remote.Parent = ReplicatedStorage
end

local DETECTION_TITLE = "Vanta Detection"
local NOTIFICATION_TITLE = "Vanta"
local DEFAULT_DURATION = 4
local DEFAULT_SEVERITY = "warn"
local DEDUPE_WINDOW = 1

local Severities = {
	info = true,
	warn = true,
	danger = true,
}

local LastSent = {}

Players.PlayerRemoving:Connect(function(Player)
	LastSent[Player] = nil
end)

--[[
	Notify:Send(Player, Detection, Duration, Severity, Message)

	Detection notification (shows "Vanta Detection" + the detection name):
		Notify:Send(Player, "AntiNoclip")
		Notify:Send(Player, "AntiFly", 5, "danger")

	Normal notification (Detection is nil or false, text goes in Message):
		Notify:Send(Player, false, 5, "info", "Welcome to the game!")
		Notify:Send(Player, nil, nil, nil, "Something happened")

	Duration: seconds, clamped 1-10 (default 4)
	Severity: "info" | "warn" | "danger" (default "warn")
--]]

function Notify:Send(Player, Detection, Duration, Severity, Message)
	if typeof(Player) ~= "Instance" or not Player:IsA("Player") then
		return
	end

	local Title
	local Text

	if typeof(Detection) == "string" and Detection ~= "" then
		-- detection notification
		Title = DETECTION_TITLE
		Text = Detection
	elseif not Detection then
		-- normal notification (Detection skipped / nil / false)
		if typeof(Message) ~= "string" or Message == "" then
			return
		end

		Title = NOTIFICATION_TITLE
		Text = Message
	else
		return
	end

	Duration = tonumber(Duration) or DEFAULT_DURATION
	Duration = math.clamp(Duration, 1, 10)

	if typeof(Severity) ~= "string" or not Severities[Severity] then
		Severity = DEFAULT_SEVERITY
	end

	local Now = os.clock()
	local PlayerLog = LastSent[Player]

	if not PlayerLog then
		PlayerLog = {}
		LastSent[Player] = PlayerLog
	end

	local Last = PlayerLog[Text]

	if Last and Now - Last < DEDUPE_WINDOW then
		return
	end

	PlayerLog[Text] = Now

	if Remote and Remote.Parent then
		Remote:FireClient(
			Player,
			Title,
			Text,
			Duration,
			Severity
		)
	end
end

return Notify]]></ProtectedString>
