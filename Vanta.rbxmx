	"the server cannot handle your swag",
	"that was actually impressive",
	"okay bro you win",
	"I respect the dedication",
	"the anti-cheat needs therapy",
	"the server got intimidated",
	"your executor passed the vibe check",
	"this is personally offensive to me",
	"I am legally required to kick you",
	"the hamster pressed the button",
	"the server hamster panicked",
	"my Lua license expired",
	"the code has decided your fate",
	"the anti-cheat woke up and chose violence",
	"the server said 'not today'",
	"your executor has too much aura",
	"the hamster union approved this kick",
	"I tried to ban you but the hamster said no",
	"the server blinked first",
	"your script was too clean, suspicious",
	"the anti-cheat is just doing its job, sorry",
	"the anti-cheat got a promotion for this",
	"a wild kick script appeared",
	"the server ran out of patience",
	"the server hamster is on break, so you're kicked",
	"the code got emotional",
	"the server is having a bad day",
	"the anti-cheat is vibing and you disturbed it",
	"the hamster spotted your executor",
	"I would explain, but I don't know either",
	"the server flipped a coin, it landed on kick",
	"your executor made the server nervous",
	"the anti-cheat read your diary",
	"the server hamster needs a nap",
	"that was a certified executor moment",
	"the anti-cheat took it personally",
	"the server saw what you did",
	"the hamster wheel stopped spinning",
	"the code compiled and so did your fate",
	"the server blames the executor",
	"nothing personal, just Lua",
	"my Lua teacher said to kick you",
	"the anti-cheat rolled a natural 20",
	"the server hamster filed a complaint",
	"your executor had a good run",
	"the server does not accept tips",
	"the anti-cheat is just built different",
	"the pixels have spoken",
	"the server is just an npc with rules",
	"the hamster got promoted to security",
	"you have been chosen by the anti-cheat",
	"the code has a grudge",
	"the server needed a hobby",
	"thanks for playing, the hamster says bye",
}

function Kick:Init(Player, ModuleName)
	if not Player or not Player:IsA("Player") then
		return
	end

	if typeof(ModuleName) ~= "string" then
		ModuleName = "Unknown"
	end

	local Message = Messages[math.random(1, #Messages)]

	Player:Kick(string.format(
		"%s\n\nDetection: %s\nVanta Anticheat (v%s)",
		Message,
		ModuleName,
		Version
	))
end

return Kick]]></ProtectedString>
