					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local AntiDeletion = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Kick = require(script.Parent.Kick)

local HEARTBEAT_TIMEOUT = 5
local STARTUP_GRACE = 15
local MAX_FAILURES = 3
local MIN_RESPONSE_INTERVAL = 0.35

local Remote = ReplicatedStorage:FindFirstChild("VNT_ClientHB")

if not Remote then
	Remote = Instance.new("RemoteEvent")
	Remote.Name = "VNT_ClientHB"
	Remote.Archivable = false
	Remote.Parent = ReplicatedStorage
end

local Sessions = {}

local function RandomToken()
	return HttpService:GenerateGUID(false)
		.. HttpService:GenerateGUID(false)
end

local function RemovePlayer(Player)
	Sessions[Player] = nil
end

local function KickPlayer(Player)
	if Player and Player.Parent then
		Kick:Init(Player, "AntiDeletion")
	end

	RemovePlayer(Player)
end

local function SetupPlayer(Player)
	local Session = {
		JoinedAt = os.clock(),
		Started = false,
		Sequence = 0,
		Challenge = RandomToken(),
		LastAccepted = 0,
		Failures = 0,
	}

	Sessions[Player] = Session

	task.defer(function()
		if Player.Parent and Sessions[Player] == Session then
			Remote:FireClient(
				Player,
				"Challenge",
				Session.Sequence,
				Session.Challenge
			)
		end
	end)
end

Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(RemovePlayer)

for _, Player in ipairs(Players:GetPlayers()) do
	SetupPlayer(Player)
end

Remote.OnServerEvent:Connect(function(Player, Action, Sequence, Challenge, ValidCount)
	local Session = Sessions[Player]

	if not Session then
		return
	end

	if Action == "GuiDeleted" then
		KickPlayer(Player)
		return
	end

	if Action ~= "Heartbeat" then
		return
	end

	if typeof(Sequence) ~= "number"
		or typeof(Challenge) ~= "string"
		or typeof(ValidCount) ~= "number" then
		Session.Failures += 1
		return
	end

	local Now = os.clock()

	if Session.LastAccepted > 0
		and Now - Session.LastAccepted < MIN_RESPONSE_INTERVAL then
		return
	end

	if Challenge ~= Session.Challenge then
		Session.Failures += 1
		return
	end

	if Sequence ~= Session.Sequence then
		Session.Failures += 1
		return
	end

	if ValidCount < 0 or ValidCount > 100000 then
		Session.Failures += 1
		return
	end

	Session.Started = true
	Session.LastAccepted = Now
	Session.Failures = 0
	Session.Sequence += 1
	Session.Challenge = RandomToken()

	Remote:FireClient(
		Player,
		"Challenge",
		Session.Sequence,
		Session.Challenge
	)
end)

task.spawn(function()
	while true do
		task.wait(0.5)

		local Now = os.clock()

		for Player, Session in pairs(Sessions) do
			if not Player.Parent then
				RemovePlayer(Player)
				continue
			end

			if not Session.Started then
				if Now - Session.JoinedAt >= STARTUP_GRACE then
					KickPlayer(Player)
				end

				continue
			end

			if Now - Session.LastAccepted >= HEARTBEAT_TIMEOUT then
				Session.Failures += 1

				if Session.Failures >= MAX_FAILURES then
					KickPlayer(Player)
				end
			end
		end
	end
end)

return AntiDeletion]]></ProtectedString>
