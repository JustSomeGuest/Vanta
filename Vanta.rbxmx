	end
end)

task.spawn(function()
	if Settings.AntiNoclip then
		require(Modules:FindFirstChild("AntiNoclip"))
	end
end)

task.spawn(function()
	if Settings.AntiFly then
		require(Modules:FindFirstChild("AntiFly"))
	end
end)]]></ProtectedString>
