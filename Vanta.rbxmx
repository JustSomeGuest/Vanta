			<ProtectedString name="Source"><![CDATA[--[[
	██╗   ██╗ █████╗ ███╗   ██╗████████╗ █████╗ 
	██║   ██║██╔══██╗████╗  ██║╚══██╔══╝██╔══██╗
	██║   ██║███████║██╔██╗ ██║   ██║   ███████║
	╚██╗ ██╔╝██╔══██║██║╚██╗██║   ██║   ██╔══██║
	 ╚████╔╝ ██║  ██║██║ ╚████║   ██║   ██║  ██║
	  ╚═══╝  ╚═╝  ╚═╝╚═╝  ╚═══╝   ╚═╝   ╚═╝  ╚═╝

	Vanta - Security, for free.
	Created by JustSomeGuest

	Version: v1.0.3

	Creator:
	GitHub: https://github.com/justsomeguest
	Roblox: https://www.roblox.com/users/10960910215/profile
	
	Source: https://github.com/JustSomeGuest/Vanta

	Setup:
	Drag this ModuleScript into 'ServerScriptService'
	Optionally change the settings below.
	Enable File > Experience Settings > Security > Allow HTTP Requests
	
	!!! DO NOT CHANGE ANYTHING EXCEPT SETTINGS !!!
--]]

local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local GroupService = game:GetService("GroupService")

local Version = "1.0.3"

local VERSION_URL = "https://raw.githubusercontent.com/JustSomeGuest/Vanta/Main/Version.txt"

local OWNER_NOTIFY_DELAY = 5

local Settings = {

	-- Strikes: each time a player is caught, they get a notification and
	-- one strike. Reaching StrikeLimit kicks them.
	-- StrikeLimit: strikes needed to kick a player.
	-- StrikeCooldown: seconds before another detection can count as a new strike.

	-- Catches backdoor scanners (exploits that hunt for vulnerable
	-- RemoteEvents) using a fake RemoteEvent as bait.
	AntiBackdoor = true,

	-- Protects all LocalScripts, ModuleScripts, RemoteEvents,
	-- UnreliableRemoteEvents, RemoteFunctions, and the notification ScreenGui
	-- from being deleted by players.
	AntiDeletion = true,

	-- Stops players from flinging others by turning off collisions between
	-- players. Players still collide with walls and other objects,
	-- so this is not noclip.
	AntiFling = true,

	-- Catches players moving faster than they should and pulls them back.
	AntiSpeed = {
		Enabled = true,

		-- Walk speeds your game uses. Add every speed your game sets
		-- (for example sprinting), or players will be flagged for it.
		AllowedSpeeds = {
			16,
		},

		StrikeLimit = 3,
		StrikeCooldown = 5,
	},

	-- Catches players who instantly jump to a far away spot
	-- and pulls them back.
	AntiTeleport = {
		Enabled = true,

		StrikeLimit = 3,
		StrikeCooldown = 5,
	},

	-- Catches players moving through walls and other solid objects.
	AntiNoclip = {
		Enabled = true,

		StrikeLimit = 3,
		StrikeCooldown = 5,
	},

	-- Catches players flying, hovering, or floating in the air.
	AntiFly = {
		Enabled = true,

		StrikeLimit = 3,
		StrikeCooldown = 5,
	},

}

local WhitelistModules = {
	"AntiFly",
	"AntiNoclip",
	"AntiSpeed",
	"AntiTeleport",
}

local Api = {}

Api.Version = Version

local function ParseVersion(Text)
	local Major, Minor, Patch = string.match(
		Text,
		"^%s*v?(%d+)%.(%d+)%.(%d+)%s*$"
	)

	if not Major then
		return nil
	end

	return {
		tonumber(Major),
		tonumber(Minor),
		tonumber(Patch),
	}
end

local function IsOutdated(Current, Latest)
	for Index = 1, 3 do
		if Latest[Index] > Current[Index] then
			return true
		end

		if Latest[Index] < Current[Index] then
			return false
		end
	end

	return false
end

local OutdatedMessage = nil
local OwnerUserId = nil
local NotifiedOwners = {}

local function ResolveOwnerUserId()
	if game.CreatorId == 0 then
		return nil
	end

	if game.CreatorType == Enum.CreatorType.User then
		return game.CreatorId
	end

	local Success, Info = pcall(function()
		return GroupService:GetGroupInfoAsync(game.CreatorId)
	end)

	if Success and Info and Info.Owner then
		return Info.Owner.Id
	end

	return nil
end

local function NotifyOwner(Player)
	if not OutdatedMessage or NotifiedOwners[Player] then
		return
	end

	NotifiedOwners[Player] = true

	task.delay(OWNER_NOTIFY_DELAY, function()
		if not Player.Parent then
			return
		end

		local Modules = script:FindFirstChild("Modules")
		local NotifyModule = Modules and Modules:FindFirstChild("Notify")

		if not NotifyModule then
			return
		end

		local Success, Notify = pcall(require, NotifyModule)

		if not Success then
			return
		end

		pcall(function()
			Notify:Send(Player, false, 8, "warn", OutdatedMessage)
		end)
	end)
end

local function CheckForUpdates()
	local Success, Body = pcall(function()
		return HttpService:GetAsync(VERSION_URL, true)
	end)

	if not Success then
		return
	end

	local Current = ParseVersion(Version)
	local Latest = ParseVersion(Body)

	if not Current or not Latest then
		return
	end

	if not IsOutdated(Current, Latest) then
		return
	end

	local NewestVersion =
		Latest[1] .. "."
		.. Latest[2] .. "."
		.. Latest[3]

	warn(
		"[Vanta Anticheat | v" .. Version .. "]"
			.. "\nThis version of Vanta is outdated! Get the newest version from the main module."
			.. "\nCurrent version: v" .. Version
			.. "\nNewest version: v" .. NewestVersion
	)

	OwnerUserId = ResolveOwnerUserId()
	OutdatedMessage = "Vanta v" .. Version .. " is outdated (newest: v" .. NewestVersion .. "). Get the newest version from the main module."

	if not OwnerUserId then
		return
	end

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player.UserId == OwnerUserId then
			NotifyOwner(Player)
		end
	end
end

if RunService:IsServer() then
	task.spawn(CheckForUpdates)

	Players.PlayerAdded:Connect(function(Player)
		if OwnerUserId and Player.UserId == OwnerUserId then
			NotifyOwner(Player)
		end
	end)

	Players.PlayerRemoving:Connect(function(Player)
		NotifiedOwners[Player] = nil
	end)
end

--[[
	Vanta.Whitelist(Player, Duration, Only)

	Temporarily prevents Vanta's movement checks from flagging a player.
	Use it for legitimate mechanics that move players in ways Vanta would
	normally detect, such as portals, teleport pads, launchers, and cutscenes.

	Player:   the player to whitelist
	Duration: how long in seconds (default 1)
	Only:     optional, a module name or a list of module names
	          leave it out to whitelist the player in every supported module

	Supported modules: AntiFly, AntiNoclip, AntiSpeed, AntiTeleport

	Usage (server scripts only):

	local Vanta = require(script.Parent.Vanta)

	-- whitelist everything for 2 seconds, then teleport
	Vanta.Whitelist(Player, 2)
	Character:PivotTo(PortalExit.CFrame)

	-- only whitelist the checks a portal would trip
	Vanta.Whitelist(Player, 2, {"AntiTeleport", "AntiNoclip"})

	-- whitelist a single module
	Vanta.Whitelist(Player, 1, "AntiSpeed")

	Call it right BEFORE moving the player.
--]]

function Api.Whitelist(Player, Duration, Only)
	if typeof(Player) ~= "Instance" or not Player:IsA("Player") then
		return
	end

	Duration = tonumber(Duration) or 1

	local Modules = script:FindFirstChild("Modules")

	if not Modules then
		return
	end

	local Targets = WhitelistModules

	if typeof(Only) == "string" then
		Targets = { Only }
	elseif typeof(Only) == "table" then
		Targets = Only
	end

	for _, Name in ipairs(Targets) do
		if not table.find(WhitelistModules, Name) then
			warn("[Vanta] Whitelist: unknown module '" .. tostring(Name) .. "'")
			continue
		end

		local ModuleScript = Modules:FindFirstChild(Name)

		if ModuleScript and ModuleScript:IsA("ModuleScript") then
			local Success, Module = pcall(require, ModuleScript)

			if Success
				and typeof(Module) == "table"
				and typeof(Module.Whitelist) == "function" then

				Module.Whitelist(Player, Duration)
			end
		end
	end
end

return setmetatable(Settings, {
	__index = Api,
})]]></ProtectedString>
