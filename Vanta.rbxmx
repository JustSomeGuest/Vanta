				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local AntiFly = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Vanta = script.Parent.Parent
local Settings = require(Vanta)
local Config = Settings.AntiFly

local Kick = require(script.Parent.Kick)
local Notify = require(script.Parent.Notify)

if not Config.Enabled then
	return AntiFly
end

local StrikeLimit = Config.StrikeLimit or 3
local StrikeCooldown = Config.StrikeCooldown or 5
local StrikeDecayTime = Config.StrikeDecayTime or 30
local SpawnGrace = Config.SpawnGrace or 1.5
local ConfirmationTime = Config.ConfirmationTime or 0.2

local GroundTolerance = Config.GroundTolerance or 2
local GroundProbeRadius = Config.GroundProbeRadius or 1
local GroundCheckDistance = Config.GroundCheckDistance or 8
local FarCheckDistance = Config.FarCheckDistance or 250

local ArcTolerance = Config.ArcTolerance or 4
local JumpVelocityMargin = Config.JumpVelocityMargin or 1.15

local HoverTime = Config.HoverTime or 1.2
local HoverVerticalSpeed = Config.HoverVerticalSpeed or 1.5
local MinHoverHeight = Config.MinHoverHeight or 6

local RiseVelocity = Config.RiseVelocity or 3
local RiseGrace = Config.RiseGrace or 0.5
local SoftRiseTime = Config.SoftRiseTime or 1.5

local MaxPing = Config.MaxPing or 0.4

local RubberbandHold = Config.RubberbandHold or 0.35
local RubberbandRadius = Config.RubberbandRadius or 4

local Debug = Config.Debug == true

local HardExempt = {
	[Enum.HumanoidStateType.Seated] = true,
	[Enum.HumanoidStateType.Swimming] = true,
	[Enum.HumanoidStateType.Climbing] = true,
}

local SoftExempt = {
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
}

local GroundRayParams = RaycastParams.new()
GroundRayParams.FilterType = Enum.RaycastFilterType.Exclude
GroundRayParams.RespectCanCollide = true
GroundRayParams.IgnoreWater = true

local ProbeOffsets = {
	Vector3.zero,
	Vector3.new(1, 0, 0),
	Vector3.new(-1, 0, 0),
	Vector3.new(0, 0, 1),
	Vector3.new(0, 0, -1),
}

local Connections = {}
local WhitelistUntil = {}

local function GetHipOffset(Humanoid, RootPart)
	if Humanoid.RigType == Enum.HumanoidRigType.R6 then
		return 3
	end

	return Humanoid.HipHeight + (RootPart.Size.Y / 2)
end

local function GetGroundInfo(Character, RootPart, Humanoid, Distance)
	GroundRayParams.FilterDescendantsInstances = {Character}

	local Origin = RootPart.Position
	local Direction = Vector3.new(0, -Distance, 0)
	local Best = nil

	for _, Offset in ipairs(ProbeOffsets) do
		local Result = Workspace:Raycast(
			Origin + Offset * GroundProbeRadius,
			Direction,
			GroundRayParams
		)

		if Result and (not Best or Result.Position.Y > Best.Position.Y) then
			Best = Result
		end
	end

	if not Best then
		return nil
	end

	local StandY = Best.Position.Y + GetHipOffset(Humanoid, RootPart)

	return {
		Position = Vector3.new(Origin.X, StandY, Origin.Z),
		Height = Origin.Y - StandY,
		Result = Best,
	}
end

local function GetMaxJumpVelocity(Humanoid)
	local Velocity

	if Humanoid.UseJumpPower then
		Velocity = Humanoid.JumpPower
	else
		Velocity = math.sqrt(2 * Workspace.Gravity * Humanoid.JumpHeight)
	end

	return Velocity * JumpVelocityMargin
end

local function Snap(RootPart, Position)
	RootPart.CFrame = CFrame.new(Position) * RootPart.CFrame.Rotation
	RootPart.AssemblyLinearVelocity = Vector3.zero
	RootPart.AssemblyAngularVelocity = Vector3.zero
end

function AntiFly.Whitelist(Player, Duration)
	if not Player then
		return
	end

	local Until = os.clock() + (Duration or 1)

	if not WhitelistUntil[Player] or Until > WhitelistUntil[Player] then
		WhitelistUntil[Player] = Until
	end
end

local function IsWhitelisted(Player)
	local Until = WhitelistUntil[Player]

	if not Until then
		return false
	end

	if os.clock() >= Until then
		WhitelistUntil[Player] = nil
		return false
	end

	return true
end

local function SetupPlayer(Player)
	local CurrentCharacter = nil
	local SpawnTime = os.clock()

	local LastGroundedPosition = nil
	local LastGroundedTime = 0
	local PlatformVelocityY = 0

	local Airborne = false
	local AirStart = 0

	local ArcStart = 0
	local ArcOriginY = 0
	local ArcVelocityY = 0

	local RiseTime = 0
	local SuspiciousTime = 0

	local HoldPosition = nil
	local HoldUntil = 0

	local Strikes = 0
	local LastStrikeTime = 0
	local LastStrikeDecay = os.clock()

	local LogTimes = {}

	local function Log(Tag, ...)
		if not Debug then
			return
		end

		local Now = os.clock()

		if LogTimes[Tag] and Now - LogTimes[Tag] < 0.5 then
			return
		end

		LogTimes[Tag] = Now

		warn("[Vanta AntiFly] " .. Player.Name .. ": " .. Tag, ...)
	end

	local function ResetAir()
		Airborne = false
		AirStart = 0
		RiseTime = 0
		SuspiciousTime = 0
	end

	local function ResetTracking(Position)
		LastGroundedPosition = Position
		LastGroundedTime = os.clock()
		PlatformVelocityY = 0

		ResetAir()

		HoldPosition = nil
		HoldUntil = 0
		LastStrikeDecay = os.clock()
	end

	local function DecayStrikes(Now)
		if Strikes > 0 and Now - LastStrikeDecay >= StrikeDecayTime then
			Strikes -= 1
			LastStrikeDecay = Now
		end
	end

	local function AnchorArc(Time, Y, VelocityY)
		ArcStart = Time
		ArcOriginY = Y
		ArcVelocityY = VelocityY
	end

	local function OnCharacterAdded(Character)
		CurrentCharacter = Character
		SpawnTime = os.clock()

		Strikes = 0
		LastStrikeTime = 0

		ResetTracking(nil)
	end

	Player.CharacterAdded:Connect(OnCharacterAdded)

	if Player.Character then
		OnCharacterAdded(Player.Character)
	end

	Connections[Player] = RunService.Heartbeat:Connect(function(DeltaTime)
		local Character = Player.Character

		if not Character or Character ~= CurrentCharacter then
			return
		end

		local RootPart = Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")

		if not RootPart or not Humanoid then
			ResetTracking(nil)
			return
		end

		local Now = os.clock()

		if Now - SpawnTime < SpawnGrace then
			ResetTracking(RootPart.Position)
			return
		end

		if IsWhitelisted(Player) then
			Log("whitelisted, skipping")
			ResetTracking(RootPart.Position)
			return
		end

		local State = Humanoid:GetState()

		if HardExempt[State] then
			Log("exempt state, skipping", State.Name)
			ResetTracking(RootPart.Position)
			return
		end

		local CurrentPosition = RootPart.Position
		local VelocityY = RootPart.AssemblyLinearVelocity.Y

		if not LastGroundedPosition then
			ResetTracking(CurrentPosition)
			return
		end

		if HoldPosition then
			if Now >= HoldUntil then
				HoldPosition = nil
			elseif (CurrentPosition - HoldPosition).Magnitude > RubberbandRadius then
				Snap(RootPart, HoldPosition)

				LastGroundedPosition = HoldPosition
				LastGroundedTime = Now
				ResetAir()

				Log("hold snap")
				return
			end
		end

		if Player:GetNetworkPing() > MaxPing then
			Log("high ping, skipping")

			if Airborne then
				AnchorArc(Now, CurrentPosition.Y, VelocityY)
				SuspiciousTime = 0
			end

			return
		end

		local Ground = GetGroundInfo(
			Character,
			RootPart,
			Humanoid,
			GroundCheckDistance
		)

		local Grounded = Ground ~= nil and Ground.Height <= GroundTolerance

		if Grounded then
			LastGroundedPosition = Ground.Position + Vector3.new(0, 0.25, 0)
			LastGroundedTime = Now
			PlatformVelocityY = math.max(0, Ground.Result.Instance.AssemblyLinearVelocity.Y)

			ResetAir()
			DecayStrikes(Now)

			return
		end

		local Soft = SoftExempt[State] == true
		local Gravity = Workspace.Gravity
		local MaxJumpVelocity = GetMaxJumpVelocity(Humanoid) + PlatformVelocityY

		if not Airborne then
			Airborne = true
			AirStart = Now
			RiseTime = 0
			SuspiciousTime = 0

			if Soft then
				AnchorArc(Now, CurrentPosition.Y, VelocityY)
			else

				AnchorArc(LastGroundedTime, LastGroundedPosition.Y, MaxJumpVelocity)
			end

			return
		end

		if Soft then
			AnchorArc(Now, CurrentPosition.Y, VelocityY)
		end

		local Reason = nil

		if not Soft then
			local T = Now - ArcStart
			local ExpectedY = ArcOriginY + ArcVelocityY * T - 0.5 * Gravity * T * T
			local Excess = CurrentPosition.Y - ExpectedY

			if Excess > ArcTolerance then
				Reason = string.format("above jump arc by %.1f studs", Excess)
			end
		end

		if VelocityY > RiseVelocity then
			RiseTime += DeltaTime
		else
			RiseTime = math.max(0, RiseTime - DeltaTime)
		end

		local AllowedRise = Soft and SoftRiseTime or (MaxJumpVelocity / Gravity + RiseGrace)

		if not Reason and RiseTime > AllowedRise then
			Reason = string.format("rising for %.2fs", RiseTime)
		end

		if not Reason
			and Now - AirStart >= HoverTime
			and math.abs(VelocityY) <= HoverVerticalSpeed then

			local Far = GetGroundInfo(Character, RootPart, Humanoid, FarCheckDistance)

			if not Far or Far.Height >= MinHoverHeight then
				Reason = "hovering"
			end
		end

		if not Reason and State == Enum.HumanoidStateType.Flying then
			Reason = "flying state"
		end

		if Reason then
			SuspiciousTime += DeltaTime
			Log("suspicious", Reason)
		else
			SuspiciousTime = math.max(0, SuspiciousTime - DeltaTime)
			DecayStrikes(Now)
		end

		if SuspiciousTime < ConfirmationTime then
			return
		end

		Snap(RootPart, LastGroundedPosition)

		HoldPosition = LastGroundedPosition
		HoldUntil = Now + RubberbandHold

		ResetAir()

		Log("rubberband", Reason)

		if Now - LastStrikeTime >= StrikeCooldown then
			LastStrikeTime = Now
			LastStrikeDecay = Now
			Strikes += 1

			if Strikes >= StrikeLimit then
				Kick:Init(Player, "AntiFly")
				return
			end

			Notify:Send(Player, "AntiFly")
		end
	end)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(Player)
	if Connections[Player] then
		Connections[Player]:Disconnect()
		Connections[Player] = nil
	end

	WhitelistUntil[Player] = nil
end)

for _, Player in ipairs(Players:GetPlayers()) do
	SetupPlayer(Player)
end

return AntiFly]]></ProtectedString>
