				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local AntiNoclip = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")

local Vanta = script.Parent.Parent
local Settings = require(Vanta)
local Config = Settings.AntiNoclip

local Kick = require(script.Parent.Kick)
local Notify = require(script.Parent.Notify)

if not Config.Enabled then
	return AntiNoclip
end

local Terrain = Workspace.Terrain

local StrikeLimit = Config.StrikeLimit or 3
local StrikeCooldown = Config.StrikeCooldown or 5
local StrikeDecayTime = Config.StrikeDecayTime or 30
local SpawnGrace = Config.SpawnGrace or 1.5
local ConfirmationTime = Config.ConfirmationTime or 0.12
local MaxStepDistance = Config.MaxStepDistance or 12

local OverlapCheckSize = Config.OverlapCheckSize or Vector3.new(1.5, 2.5, 1.5)

local MinPenetration = Config.MinPenetration or 0
local InsideMargin = Config.InsideMargin or 0.15
local MaxRayHops = Config.MaxRayHops or 8

local RubberbandHold = Config.RubberbandHold or 0.4
local RubberbandRadius = Config.RubberbandRadius or 3

local Debug = Config.Debug == true

local HardExempt = {
	[Enum.HumanoidStateType.Seated] = true,
	[Enum.HumanoidStateType.Swimming] = true,
	[Enum.HumanoidStateType.Climbing] = true,
}

local SoftExempt = {
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
}

local OriginalCollide = setmetatable({}, {
	__mode = "k"
})

local Connections = {}
local WhitelistUntil = {}
local CollisionWhitelist = {}
local CollisionConnections = {}

local OverlapFilter = OverlapParams.new()
OverlapFilter.FilterType = Enum.RaycastFilterType.Exclude
OverlapFilter.RespectCanCollide = false

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.RespectCanCollide = false
RayParams.IgnoreWater = true

local function IsCharacterPart(Part)
	local Model = Part:FindFirstAncestorOfClass("Model")

	return Model ~= nil
		and Model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function CanPhysicallyCollide(Part, Character)
	if Part == Terrain then
		return true
	end

	if not Part:IsA("BasePart") then
		return false
	end

	if not Part.CanCollide then
		return false
	end

	local RootPart = Character:FindFirstChild("HumanoidRootPart")

	if not RootPart then
		return true
	end

	local Success, Result = pcall(
		PhysicsService.CollisionGroupsAreCollidable,
		PhysicsService,
		Part.CollisionGroup,
		RootPart.CollisionGroup
	)

	if Success then
		return Result
	end

	return true
end

local function RecordPart(Part)
	if not Part:IsA("BasePart") or IsCharacterPart(Part) then
		return
	end

	if OriginalCollide[Part] == nil then
		OriginalCollide[Part] = Part.CanCollide
	end
end

local function WatchPart(Part)
	if not Part:IsA("BasePart") or IsCharacterPart(Part) then
		return
	end

	RecordPart(Part)

	if CollisionConnections[Part] then
		return
	end

	CollisionConnections[Part] =
		Part:GetPropertyChangedSignal("CanCollide"):Connect(function()
			local Original = OriginalCollide[Part]

			if Original == nil or Part.CanCollide == Original then
				return
			end

			local Until = CollisionWhitelist[Part]

			if Until and os.clock() < Until then
				return
			end

			CollisionWhitelist[Part] = nil
			Part.CanCollide = Original
		end)
end

for _, Descendant in ipairs(Workspace:GetDescendants()) do
	WatchPart(Descendant)
end

Workspace.DescendantAdded:Connect(WatchPart)

Workspace.DescendantRemoving:Connect(function(Descendant)
	if CollisionConnections[Descendant] then
		CollisionConnections[Descendant]:Disconnect()
		CollisionConnections[Descendant] = nil
	end

	CollisionWhitelist[Descendant] = nil
	OriginalCollide[Descendant] = nil
end)

function AntiNoclip.Whitelist(Player, Duration)
	if not Player then
		return
	end

	local Until = os.clock() + (Duration or 1)

	if not WhitelistUntil[Player] or Until > WhitelistUntil[Player] then
		WhitelistUntil[Player] = Until
	end
end

function AntiNoclip.WhitelistCollisionChange(Part, Duration)
	if not Part or not Part:IsA("BasePart") then
		return
	end

	CollisionWhitelist[Part] = os.clock() + (Duration or 1)
end

local function IsWhitelisted(Player)
	local Until = WhitelistUntil[Player]

	if not Until then
		return false
	end

	if os.clock() >= Until then
		WhitelistUntil[Player] = nil
		return false
	end

	return true
end

local function IsSolid(Part, Character)
	if Part == Terrain then
		return true
	end

	return Part:IsA("BasePart")
		and OriginalCollide[Part] == true
		and CanPhysicallyCollide(Part, Character)
end

local function IsInsideBlock(Part, Position)
	if not Part:IsA("Part") or Part.Shape ~= Enum.PartType.Block then
		return false
	end

	local LocalPosition = Part.CFrame:PointToObjectSpace(Position)
	local Half = Part.Size / 2 - Vector3.new(InsideMargin, InsideMargin, InsideMargin)

	return math.abs(LocalPosition.X) < Half.X
		and math.abs(LocalPosition.Y) < Half.Y
		and math.abs(LocalPosition.Z) < Half.Z
end

local function FindPenetratingPart(Position, Character)
	OverlapFilter.FilterDescendantsInstances = {Character}

	local Parts = Workspace:GetPartBoundsInBox(
		CFrame.new(Position),
		OverlapCheckSize,
		OverlapFilter
	)

	for _, Part in ipairs(Parts) do
		if Part ~= Terrain
			and IsSolid(Part, Character)
			and IsInsideBlock(Part, Position) then

			return Part
		end
	end

	return nil
end

local function CastSolid(Origin, Direction, Character)
	local Filter = {Character}

	for _ = 1, MaxRayHops do
		RayParams.FilterDescendantsInstances = Filter

		local Result = Workspace:Raycast(Origin, Direction, RayParams)

		if not Result then
			return nil
		end

		local Hit = Result.Instance

		if IsSolid(Hit, Character) then
			return Result
		end

		if IsCharacterPart(Hit) then
			table.insert(Filter, Hit:FindFirstAncestorOfClass("Model"))
		else
			table.insert(Filter, Hit)
		end
	end

	return nil
end

local function CheckPath(FromPosition, ToPosition, Character)
	local Delta = ToPosition - FromPosition
	local Distance = Delta.Magnitude

	if Distance <= 0.001 then
		return nil
	end

	local Result = CastSolid(FromPosition, Delta, Character)

	if not Result then
		return nil
	end

	local Penetration = Distance - (Result.Position - FromPosition).Magnitude

	if Penetration < MinPenetration then
		return nil
	end

	return Result.Instance
end

local function Snap(RootPart, Position)
	RootPart.CFrame = CFrame.new(Position) * RootPart.CFrame.Rotation
	RootPart.AssemblyLinearVelocity = Vector3.zero
	RootPart.AssemblyAngularVelocity = Vector3.zero
end

local function SetupPlayer(Player)
	local LastPosition = nil
	local LastSafePosition = nil
	local SpawnTime = os.clock()
	local CurrentCharacter = nil

	local Strikes = 0
	local LastStrikeTime = 0
	local LastStrikeDecay = os.clock()

	local SuspiciousTime = 0
	local WasInside = false

	local HoldPosition = nil
	local HoldUntil = 0

	local LogTimes = {}

	local function Log(Tag, ...)
		if not Debug then
			return
		end

		local Now = os.clock()

		if LogTimes[Tag] and Now - LogTimes[Tag] < 0.5 then
			return
		end

		LogTimes[Tag] = Now

		warn("[Vanta AntiNoclip] " .. Player.Name .. ": " .. Tag, ...)
	end

	local function ResetTracking(Position)
		LastPosition = Position
		LastSafePosition = Position
		SuspiciousTime = 0
		WasInside = false
		HoldPosition = nil
		LastStrikeDecay = os.clock()
	end

	local function OnCharacterAdded(Character)
		CurrentCharacter = Character
		SpawnTime = os.clock()

		Strikes = 0
		LastStrikeTime = 0

		ResetTracking(nil)
	end

	Player.CharacterAdded:Connect(OnCharacterAdded)

	if Player.Character then
		OnCharacterAdded(Player.Character)
	end

	Connections[Player] = RunService.Heartbeat:Connect(function(DeltaTime)
		local Character = Player.Character

		if not Character or Character ~= CurrentCharacter then
			return
		end

		local RootPart = Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")

		if not RootPart or not Humanoid then
			ResetTracking(nil)
			return
		end

		local Now = os.clock()

		if Now - SpawnTime < SpawnGrace then
			ResetTracking(RootPart.Position)
			return
		end

		if IsWhitelisted(Player) then
			Log("whitelisted, skipping")
			ResetTracking(RootPart.Position)
			return
		end

		local State = Humanoid:GetState()

		if HardExempt[State] then
			Log("exempt state, skipping", State.Name)
			ResetTracking(RootPart.Position)
			return
		end

		local CheckInside = not SoftExempt[State]
		local CurrentPosition = RootPart.Position

		if not LastPosition then
			LastPosition = CurrentPosition
			LastSafePosition = CurrentPosition
			return
		end

		if HoldPosition then
			if Now >= HoldUntil then
				HoldPosition = nil
			elseif (CurrentPosition - HoldPosition).Magnitude > RubberbandRadius then
				Snap(RootPart, HoldPosition)

				LastPosition = HoldPosition
				LastSafePosition = HoldPosition
				SuspiciousTime = 0
				WasInside = false

				Log("hold snap")
				return
			end
		end

		local Moved = (CurrentPosition - LastPosition).Magnitude > 0.001

		local Crossed = nil

		if Moved then
			local StepFromSafe = (CurrentPosition - LastSafePosition).Magnitude

			if StepFromSafe <= MaxStepDistance then
				Crossed = CheckPath(LastSafePosition, CurrentPosition, Character)
			else
				Log("step too large, path check skipped", math.floor(StepFromSafe))
			end
		end

		local Inside = nil

		if not Crossed and CheckInside and (Moved or WasInside) then
			Inside = FindPenetratingPart(CurrentPosition, Character)
		end

		local Exited = CheckInside
			and WasInside
			and Inside == nil
			and Moved
			and not Crossed

		WasInside = Inside ~= nil

		local Reason = nil

		if Crossed then
			Reason = "crossed " .. Crossed:GetFullName()
			SuspiciousTime = ConfirmationTime
		elseif Exited then
			Reason = "moved out of a solid"
			SuspiciousTime = ConfirmationTime
		elseif Inside then
			Reason = "inside " .. Inside:GetFullName()
			SuspiciousTime += DeltaTime
		else
			SuspiciousTime = math.max(0, SuspiciousTime - DeltaTime)
		end

		if SuspiciousTime >= ConfirmationTime then
			local RecoveryPosition = LastSafePosition

			Snap(RootPart, RecoveryPosition)

			LastPosition = RecoveryPosition
			SuspiciousTime = 0
			WasInside = false

			HoldPosition = RecoveryPosition
			HoldUntil = Now + RubberbandHold

			Log("rubberband", Reason)

			if Now - LastStrikeTime >= StrikeCooldown then
				LastStrikeTime = Now
				Strikes += 1

				if Strikes >= StrikeLimit then
					Kick:Init(Player, "AntiNoclip")
					return
				end

				Notify:Send(Player, "AntiNoclip")
			end

			return
		end

		LastPosition = CurrentPosition

		if not Inside then
			LastSafePosition = CurrentPosition
		end

		if Strikes > 0
			and Now - LastStrikeDecay >= StrikeDecayTime then

			Strikes -= 1
			LastStrikeDecay = Now
		end
	end)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(Player)
	if Connections[Player] then
		Connections[Player]:Disconnect()
		Connections[Player] = nil
	end

	WhitelistUntil[Player] = nil
end)

for _, Player in ipairs(Players:GetPlayers()) do
	SetupPlayer(Player)
end

return AntiNoclip]]></ProtectedString>
					<string name="ScriptGuid">{83D7F3C3-581F-4FAE-BA45-AF89B702EB4C}</string>
